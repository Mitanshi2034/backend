# ---- Server ----
PORT=4000

# ---- Database (Supabase) ----
# Supabase dashboard > Connect > "Session pooler" connection string (IPv4-compatible; needed for Render).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Leave true for Supabase. Set false only for a local Postgres without SSL.
DATABASE_SSL=true

# ---- CORS ----
# Comma-separated frontend URLs allowed to call the API (local Vite + your Vercel URL).
CORS_ORIGIN=http://localhost:5173

# ---- Scheduler ----
# Long random string. cron-job.org sends it in the "x-cron-secret" header.
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-me

# ---- Scraper ----
STORE_BASE_URL=https://demo.inelabteamdev.com
# true = invisible browser (production). false = visible window (headed mode).
HEADLESS=true
